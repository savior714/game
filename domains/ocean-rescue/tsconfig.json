{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.js",
    "vite.config.ts",
    "vite.shadow.config.ts",
    "vite.production.config.ts",
    "vite.bundle.ts"
  ],
  "exclude": [
    "src/vendor/**",
    "src/render-assets.generated.js"
  ]
}